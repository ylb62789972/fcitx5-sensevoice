<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="@dimen/voice_panel_height"
              android:background="@color/voice_surface"
              android:orientation="vertical"
              android:padding="8dp"
              tools:ignore="HardcodedText,SpUsage,SmallSp">

    <!-- 第一层：顶部工具与剪贴板栏 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageButton
                android:id="@+id/back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="@string/return_to_previous_input_method"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"/>

        <Button
                android:id="@+id/btn_paste_translate_zh"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.2"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="📋粘贴译中"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_paste_draft"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1.1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="📥贴草稿"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_quick_snippet"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="⭐常用词"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_copy_draft"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="📄复制"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_clear_draft"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="🗑️清空"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <ImageButton
                android:id="@+id/delete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/icon_button_background"
                android:contentDescription="@string/delete_previous_character"
                android:padding="8dp"
                android:src="@drawable/ic_backspace"/>
    </LinearLayout>

    <!-- 第二层：文字预览与核对框 -->
    <TextView
            android:id="@+id/draft_preview"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/icon_button_background"
            android:gravity="top|start"
            android:hint="语音识别结果与译文预览区（核对房号、金额、账号）"
            android:maxLines="4"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textColor="@color/voice_text_primary"
            android:textColorHint="@color/voice_text_secondary"
            android:textIsSelectable="true"
            android:textSize="14sp"/>

    <!-- 第三层：五国语言去口语上屏按钮 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btn_commit_zh"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.15"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="直接上中文"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_translate_el"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="🇬🇷希腊语"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_translate_en"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="🇬🇧英语"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_translate_ar"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="🇸🇦阿拉伯"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <Button
                android:id="@+id/btn_translate_tr"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/icon_button_background"
                android:padding="2dp"
                android:text="🇹🇷土耳其"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>
    </LinearLayout>

    <!-- 第四层：底部录音区与状态提示 -->
    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

        <Button
                android:id="@+id/btn_import_model"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/icon_button_background"
                android:padding="4dp"
                android:text="📂选模型"
                android:textAllCaps="false"
                android:textColor="@color/voice_text_primary"
                android:textSize="11sp"/>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

            <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="80dp">

                <com.fcitx5sensevoice.VoiceWaveView
                        android:id="@+id/voice_wave"
                        android:layout_width="132dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"/>

                <ImageButton
                        android:id="@+id/microphone"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:background="@drawable/microphone_background_disabled"
                        android:contentDescription="@string/microphone_busy"
                        android:elevation="6dp"
                        android:padding="20dp"
                        android:src="@drawable/ic_microphone"/>
            </FrameLayout>

            <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:fontFamily="sans-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/status_model_initializing"
                    android:textColor="@color/voice_text_primary"
                    android:textSize="13sp"/>

            <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp">

                <TextView
                        android:id="@+id/status_hint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/voice_text_secondary"
                        android:textSize="11sp"/>

                <FrameLayout
                        android:id="@+id/loading_skeleton"
                        android:layout_width="140dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:background="@drawable/skeleton_background"
                        android:clipToOutline="true"
                        android:visibility="gone">

                    <View
                            android:id="@+id/loading_sheen"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/skeleton_sheen"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

            <Button
                    android:id="@+id/btn_paste_direct"
                    android:layout_width="68dp"
                    android:layout_height="38dp"
                    android:background="@drawable/icon_button_background"
                    android:padding="2dp"
                    android:text="📤直贴"
                    android:textAllCaps="false"
                    android:textColor="@color/voice_text_primary"
                    android:textSize="11sp"/>

            <ImageButton
                    android:id="@+id/enter"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/icon_button_background"
                    android:contentDescription="@string/send_or_enter"
                    android:padding="10dp"
                    android:src="@drawable/ic_enter"/>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
